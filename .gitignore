# Mutable runtime data, exports and backups
/data/
/uploads/
/exports/
/backups/

# Temporary files and editor backups
*.tmp
*.bak
*.swp
*.swo

# Operating system metadata
.DS_Store
Thumbs.db
Desktop.ini
