{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@cv/core": ["packages/core/src/index.ts"],
      "@cv/renderer": ["packages/renderer/src/index.tsx"]
    }
  },
  "include": ["apps", "packages", "tests", "vite.config.ts", "playwright.config.ts"]
}
